{
  "name": "@sesori/pr-monitor-opencode",
  "version": "0.3.0",
  "description": "OpenCode plugin that watches GitHub PRs in the background and delivers factual [PR Monitor] reports into the owning session",
  "license": "MIT",
  "type": "module",
  "main": "./opencode/index.ts",
  "exports": {
    ".": "./opencode/index.ts",
    "./server": "./opencode/index.ts"
  },
  "files": [
    "core",
    "runtime",
    "opencode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sesori-ai/opencode-pr-monitor.git"
  },
  "homepage": "https://github.com/sesori-ai/opencode-pr-monitor#readme",
  "bugs": {
    "url": "https://github.com/sesori-ai/opencode-pr-monitor/issues"
  },
  "author": {
    "name": "Sesori",
    "url": "https://github.com/sesori-ai"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "github",
    "pull-request",
    "monitor"
  ],
  "engines": {
    "opencode": ">=1.17.0"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild claude-code/src/mcp-server.ts --bundle --platform=node --format=esm --target=node18 --outfile=claude-code/dist/mcp-server.mjs --log-level=warning --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "pack:check": "node scripts/check-pack.mjs",
    "prepublishOnly": "npm test && npm run typecheck && npm run pack:check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.4.9"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0",
    "zod": "^4.4.3"
  }
}
