{
  "name": "@sesori/pr-monitor-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "opencode"
  ],
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:opencode && npm run build:claude",
    "build:opencode": "node scripts/build-opencode.mjs",
    "build:claude": "node scripts/build-claude.mjs",
    "clean": "node scripts/clean.mjs",
    "pack:check": "npm run build:opencode && node scripts/check-pack.mjs",
    "version:check": "node scripts/check-versions.mjs",
    "release:check": "npm test && npm run typecheck && npm run build && npm run version:check && npm run pack:check"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0",
    "zod": "^4.4.3"
  }
}
